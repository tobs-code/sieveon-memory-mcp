# Sieveon - Environment Configuration
# Copy this file to .env and update values as needed

# SurrealDB Configuration
SURREALDB_URL=http://127.0.0.1:8000/sql
SURREALDB_USER=root
SURREALDB_PASS=root
SURREALDB_NS=sieveon
SURREALDB_DB=sieveon

# Server Ports
# Only the control plane runs as a separate HTTP service. The router and the
# planner are in-process libraries (src/router, src/planner) and have no port.
CONTROL_PLANE_PORT=8082

# Other Configuration
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B

# Groq API (explicit opt-in only, NOT in the default chain)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Extraction method: "auto" → relex → gliner → spacy (all local).
# "relex" / "gliner" / "spacy" → that backend only. "groq" → Groq API only.
EXTRACTION_METHOD=auto

# Local backend thresholds (relex relations need 0.7+, entities 0.5)
RELEX_ENT_THRESHOLD=0.5
RELEX_REL_THRESHOLD=0.7
GLINER_ENT_THRESHOLD=0.5
GLINER_REL_THRESHOLD=0.7

# Tiering: co-occurrence facts below this salience are not created as KG
# facts (mentions stay as provenance). SVO facts never tiered. 0 = disabled.
TIER_DROP_THRESHOLD=0.5
